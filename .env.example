# The controller installer creates .env automatically with a random PostgreSQL
# password. Keep the generated file private and back it up with the database.
SPRING_PROFILES_ACTIVE=production
POSTGRES_DB=guanlan_monitor
POSTGRES_USER=guanlan
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
SETTINGS_ENCRYPTION_KEY=

# Required deployment settings. Run deploy/install-controller.ps1 or
# deploy/install-controller.sh to fill these values interactively.
WEB_PORT=
WEB_BIND_ADDRESS=
BOOTSTRAP_ADMIN_USERNAME=
APP_TIMEZONE=
METRIC_RETENTION_DAYS=
DEVICE_OFFLINE_AFTER_SECONDS=
SESSION_COOKIE_SECURE=
ALLOW_INSECURE_HTTP=false
ALLOWED_ORIGINS=
SITE_NAME=
PUBLIC_BASE_URL=

# Generated by the Linux controller installer. This makes the controller host
# appear in Device Management without a separate manual Agent installation.
CONTROLLER_AGENT_ENABLED=false
CONTROLLER_AGENT_DEVICE_ID=
CONTROLLER_AGENT_KEY=
CONTROLLER_AGENT_NAME=总控服务器
CONTROLLER_AGENT_GROUP=控制平面

# Optional notification environment fallbacks. Administrators can replace these
# values in the Web console; database values are encrypted and take precedence.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
DINGTALK_WEBHOOK_URL=
DINGTALK_KEYWORD=
DINGTALK_SIGN_SECRET=
WECOM_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_FORMAT=GENERIC_JSON

# Optional update source overrides. Comma-separated GHCR mirror prefixes are
# attempted before the official ghcr.io registry.
GUANLAN_CONTROLLER_IMAGE_MIRRORS=ghcr.1ms.run,ghcr.nju.edu.cn
GUANLAN_AGENT_IMAGE_MIRRORS=ghcr.1ms.run,ghcr.nju.edu.cn
CONTROLLER_AUTO_UPDATE=false
