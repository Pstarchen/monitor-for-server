# The controller installer creates .env automatically with a random PostgreSQL
# password. Keep the generated file private and back it up with the database.
SPRING_PROFILES_ACTIVE=production
POSTGRES_DB=xingchen_monitor
POSTGRES_USER=xingchen
POSTGRES_PASSWORD=
COMPOSE_PROJECT_NAME=xingchen-monitor
BOOTSTRAP_ADMIN_PASSWORD=
SETTINGS_ENCRYPTION_KEY=

# Required deployment settings. Run deploy/install-controller.ps1 or
# deploy/install-controller.sh to fill these values interactively.
WEB_PORT=
WEB_BIND_ADDRESS=
BOOTSTRAP_ADMIN_USERNAME=
APP_TIMEZONE=
METRIC_RETENTION_DAYS=
DEVICE_OFFLINE_AFTER_SECONDS=
SESSION_COOKIE_SECURE=
ALLOW_INSECURE_HTTP=false
ALLOWED_ORIGINS=
SITE_NAME=
PUBLIC_BASE_URL=

# Generated by the Linux controller installer. This makes the controller host
# appear in Device Management without a separate manual Agent installation.
CONTROLLER_AGENT_ENABLED=false
CONTROLLER_AGENT_DEVICE_ID=
CONTROLLER_AGENT_KEY=
CONTROLLER_AGENT_NAME=总控服务器
CONTROLLER_AGENT_GROUP=控制平面

# Optional notification environment fallbacks. Administrators can replace these
# values in the Web console; database values are encrypted and take precedence.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
DINGTALK_WEBHOOK_URL=
DINGTALK_KEYWORD=
DINGTALK_SIGN_SECRET=
WECOM_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_FORMAT=GENERIC_JSON

# Optional durable realtime and Huawei HarmonyOS Push Kit V3 delivery. This is
# not Web Push, FCM, APNs, or the legacy Huawei OAuth Push API. Push Kit remains
# disabled until a Huawei service-account key is supplied outside Git.
REALTIME_REDIS_CHANNEL=monitor:realtime:v1
REALTIME_OUTBOX_BATCH_SIZE=100
REALTIME_REPLAY_BATCH_SIZE=200
REALTIME_RETENTION_HOURS=24
REALTIME_TICKET_TTL_SECONDS=30
PUSH_KIT_ENABLED=false
PUSH_KIT_PROJECT_ID=
PUSH_KIT_KEY_ID=
PUSH_KIT_SUB_ACCOUNT=
PUSH_KIT_PRIVATE_KEY=
PUSH_KIT_CATEGORY=MARKETING
PUSH_KIT_TTL_SECONDS=86400
PUSH_KIT_BATCH_SIZE=50
PUSH_KIT_MAX_ATTEMPTS=5

# Optional update source overrides. Set these to registries operated or trusted
# by your organization. Public mirror accelerators are intentionally not enabled.
XINGCHEN_CONTROLLER_IMAGE_MIRRORS=
XINGCHEN_AGENT_IMAGE_MIRRORS=
# Configured mirror registries fail over quickly; direct image references keep
# the longer XINGCHEN_UPDATE_PULL_TIMEOUT_SECONDS timeout.
XINGCHEN_UPDATE_MIRROR_TIMEOUT_SECONDS=45
XINGCHEN_UPDATE_PULL_TIMEOUT_SECONDS=180
XINGCHEN_UPDATE_MIN_FREE_BYTES=1073741824
# Source builds use Gitee by default. Add an internal Git service first and add
# GitHub last only when target servers are explicitly allowed to access it.
XINGCHEN_SOURCE_REPOSITORIES=https://gitee.com/starchen520/monitor-for-server.git
XINGCHEN_SOURCE_REF=main
XINGCHEN_SOURCE_BUILD_TIMEOUT_SECONDS=1200
CONTROLLER_AUTO_UPDATE=false
CONTROLLER_BACKUP_AUTO=false
CONTROLLER_BACKUP_RETENTION=7
