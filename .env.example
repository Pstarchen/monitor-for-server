# Required external MySQL connection. Create the database and least-privilege
# user before running the controller installer; the installer never provisions
# or changes your database server.
DB_URL=jdbc:mysql://127.0.0.1:3306/monitor?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=monitor
DB_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
SETTINGS_ENCRYPTION_KEY=

# Required deployment settings. Run deploy/install-controller.ps1 or
# deploy/install-controller.sh to fill these values interactively.
WEB_PORT=
WEB_BIND_ADDRESS=
BOOTSTRAP_ADMIN_USERNAME=
APP_TIMEZONE=
METRIC_RETENTION_DAYS=
DEVICE_OFFLINE_AFTER_SECONDS=
SESSION_COOKIE_SECURE=
ALLOW_INSECURE_HTTP=false
ALLOWED_ORIGINS=
SITE_NAME=
PUBLIC_BASE_URL=

# Optional notification environment fallbacks. Administrators can replace these
# values in the Web console; database values are encrypted and take precedence.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
DINGTALK_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
