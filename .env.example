# Required. Generate independent random values for every deployment.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=
SETTINGS_ENCRYPTION_KEY=

# Optional deployment settings.
WEB_PORT=8080
BOOTSTRAP_ADMIN_USERNAME=admin
APP_TIMEZONE=Asia/Shanghai
METRIC_RETENTION_DAYS=30
DEVICE_OFFLINE_AFTER_SECONDS=30
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080
SITE_NAME=观澜监控
PUBLIC_BASE_URL=http://localhost:8080

# Optional notification environment fallbacks. Administrators can replace these
# values in the Web console; database values are encrypted and take precedence.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
DINGTALK_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
