# Required. Generate independent random values for every deployment.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional deployment settings.
WEB_PORT=8080
BOOTSTRAP_ADMIN_USERNAME=admin
APP_TIMEZONE=Asia/Shanghai
METRIC_RETENTION_DAYS=30
DEVICE_OFFLINE_AFTER_SECONDS=30
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080

# Optional notification channels. Keep webhook tokens and SMTP passwords here,
# never in the database or frontend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
DINGTALK_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
