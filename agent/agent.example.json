{
  "server_url": "https://monitor.example.com",
  "device_id": "replace-with-device-id",
  "agent_key": "replace-with-one-time-agent-key",
  "interval": "3s",
  "request_timeout": "10s",
  "spool_dir": "data/spool",
  "max_buffered_reports": 10000,
  "allow_insecure_http": false,
  "monitored_services": ["nginx", "sshd"],
  "monitored_processes": ["java", "postgres"],
  "skip_process_collection": false,
  "collect_all_processes": false,
  "process_collection_limit": 12,
  "skip_connection_count": false,
  "skip_port_collection": false,
  "port_collection_limit": 512,
  "skip_container_collection": false,
  "container_collection_limit": 100,
  "disk_mountpoints": ["/", "/data"],
  "host_root": "",
  "docker_socket": "",
  "log_paths": [],
  "collect_system_logs": false,
  "integrity_paths": [],
  "custom_metrics": [
    {"name": "queue_depth", "command": "/usr/local/bin/queue-depth", "args": [], "kind": "number"},
    {"name": "release", "command": "/usr/local/bin/release-name", "args": [], "kind": "text"}
  ],
  "allow_command_execution": false,
  "allow_file_operations": false,
  "command_poll_interval": "1s",
  "max_command_output_bytes": 65536
}
